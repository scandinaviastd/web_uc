---
// Carrusel principal del Kit (componentes/carrusel-principal). Solo en la home, bajo el header.
// Estilo y comportamiento del Kit sin modificar; data-autoplaybutton agrega el botón de pausa (WCAG 2.2.2).
import { getPrograma } from '../data/programas.js';
// Cada slide referencia un programa: título, estado y enlace vienen de su ficha (en WordPress, campo relación).
const slides = [
  { slug: 'formando-nuevos-directores', imagen: '/img/hero/formando-nuevos-directores.jpg' },
  { slug: 'diplomado-gobierno-corporativo', imagen: '/img/hero/diplomado.jpg' },
  { slug: 'empresas-familiares', imagen: '/img/hero/empresas-familiares.jpg' },
].map(({ slug, imagen }) => { const p = getPrograma(slug); return { tag: p.estado, titulo: p.titulo, cta: 'Conoce el programa', href: `/formacion/${slug}/`, imagen }; });
// Imágenes del sitio actual del Centro (banners sin texto; fotos de stock: confirmar licencia).
---
<div class="uc-carousel cgc-hero" data-carousel="uc-primary-carousel" data-type="carousel" data-items="1" data-slideby="1" data-loop="true" data-nav="true" data-autoplay="true" data-controls="false" data-navcontainer="#carousel-nav" data-autoplaybutton="#carousel-autoplay" data-autoplay-text="true">
  <div class="uc-primary-carousel">
    {slides.map((s) => (
      <div class="primary-carousel_item uc-card card-bg--image card-gradient--bottom-black card-radius--none card-border--none">
        <img class="carousel-img" src={s.imagen} alt="" />
        <div class="primary-carousel_item-content">
          <div class="container mt-auto">
            <div class="row">
              <div class="col-lg-7">
                <span class="uc-tag">{s.tag}</span>
                <div class="h1 color-white mt-12 mb-24">{s.titulo}</div>
                <a href={s.href} class="uc-btn btn-cta cgc-btn-auto">{s.cta}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="uc-carousel-nav primary-carousel-nav">
    <div class="container">
      <div class="carousel-nav-container">
        <ul class="carousel-nav-list" id="carousel-nav">
          {slides.map((_, i) => (
            <li class="carousel-nav-item"><div class="number">{String(i + 1).padStart(2, '0')}</div><div class="indicator"></div></li>
          ))}
        </ul>
        <div class="autoplay-buttons" id="carousel-autoplay"></div>
      </div>
    </div>
  </div>
</div>
