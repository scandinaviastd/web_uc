---
// Card/Persona — foto 1:1 (fotos_perfil/) o, si aún no hay foto, avatar con iniciales del Kit (.avatar + .avatar--initials).
import { fotoDe, inicialesDe } from '../data/contenidos.js';
interface Props { nombre: string; cargo: string; correo?: string; telefono?: string; foto?: string }
const { nombre, cargo, correo, telefono } = Astro.props;
const foto = Astro.props.foto ?? fotoDe(nombre);
---
<article class="uc-card card-height--same cgc-card-persona">
  {foto
    ? <img src={foto} class="uc-card-img cgc-img-1x1" alt={`Foto de ${nombre}`} loading="lazy" width="800" height="800" />
    : <div class="avatar cgc-avatar-card" role="img" aria-label={`${nombre} (foto pendiente)`}><span class="avatar--initials">{inicialesDe(nombre)}</span></div>}
  <div class="uc-card_body">
    <h3 class="h5 mb-4">{nombre}</h3>
    <p class="text-color--gray mb-0">{cargo}</p>
    {correo && <p class="text-size--sm mb-0 mt-8"><a href={correo.includes('@') ? `mailto:${correo}` : '#'}>{correo}</a></p>}
    {telefono && <p class="text-size--sm mb-0">{telefono}</p>}
  </div>
</article>
