---
// Footer de submarca según Kit UC (views/footer-submarca.php) + footer global UC (#uc-global-footer)
// + footer UC de créditos (.uc-dev-footer) con Políticas de Privacidad (obligatorio).
import { sitio, sara } from '../data/sitio.js';
---
<footer class="uc-footer">
  <div class="container pb-80">
    <div class="row align-items-center justify-content-between">
      <div class="col-6 col-md-5 col-lg-4 col-xl-3 mb-32">
        <a href="/"><img src="https://kit-digital-uc-prod.s3.amazonaws.com/assets/logo-uc-blanco.svg" alt="Logo Pontificia Universidad Católica de Chile" class="img-fluid my-12" /></a>
      </div>
      <div class="col-lg-4 text-left text-lg-right">
        <div class="uc-subtitle color-white mb-16">{sitio.nombre}</div>
        <div class="mb-16">{sitio.direccion}</div>
        <div class="mb-16">{sitio.unidad}</div>
        <div class="mb-16"><i class="uc-icon">phone</i> {sitio.telefono} · {sitio.correo}</div>
        <div class="mb-16">Contacto: {sara.nombre} · <a href={`mailto:${sara.correo}`} class="cgc-footer-link">{sara.correo}</a></div>
        <div class="mb-16">
          <a href={sitio.whatsappUrl} class="cgc-footer-link" target="_blank" rel="noopener"><img src="/img/whatsapp-verde.svg" alt="" width="18" height="18" class="cgc-inline-icon" /> {sitio.whatsapp}<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
        </div>
        <div class="mb-32"><a href={sitio.comoLlegar} class="cgc-footer-link" target="_blank" rel="noopener">¿Cómo llegar?</a></div>
      </div>
    </div>
  </div>
  <div id="uc-global-footer"></div>
  <div class="uc-dev-footer">
    <div class="container">
      <ul class="uc-footer-dev_content">
        <li>Diseño y desarrollo: {sitio.creditos.disenoDesarrollo.url === '#'
          ? <a href="#" class="external" data-pendiente="Enlace de Scandinavia Studio por confirmar.">{sitio.creditos.disenoDesarrollo.nombre}</a>
          : <a href={sitio.creditos.disenoDesarrollo.url} target="_blank" rel="noopener" class="external">{sitio.creditos.disenoDesarrollo.nombre}</a>}</li>
        <li>Sitio administrado por: <a href={sitio.creditos.administradoPor.url} class="external">{sitio.creditos.administradoPor.nombre}</a></li>
        <li>Utilizando el <a href="https://kitdigital.uc.cl/" target="_blank" rel="noopener" class="external">Kit Digital UC</a></li>
        <li><a href={sitio.politicaPrivacidad} class="external" data-pendiente="Enlace a la Política de Protección de Datos UC por confirmar con proteccion.datos@uc.cl.">Políticas de Privacidad</a></li>
      </ul>
    </div>
  </div>
</footer>
