---
// Card/Documento — PDF descargable. Variante con portada (Estudios) o con cita en campos (Artículos y WP).
interface Props { titulo: string; tipo?: string; anio?: string; autores?: string; publicacion?: string; portada?: boolean; href?: string }
const { titulo, tipo, anio, autores, publicacion, portada = false, href = '#' } = Astro.props;
---
<article class="uc-card card-height--same cgc-card cgc-card-doc" data-anio={anio} data-texto={`${titulo} ${autores ?? ''}`.toLowerCase()}>
  {portada && <img src="/img/ph-portada.svg" class="uc-card-img cgc-img-portada" alt={`Portada de ${titulo}`} loading="lazy" />}
  <div class="uc-card_body">
    {(tipo || anio) && (
      <div class="d-flex align-items-center mb-12">
        {tipo && <span class="uc-tag">{tipo}</span>}
        {anio && <span class="text-size--sm text-color--gray ml-8">{anio}</span>}
      </div>
    )}
    <h3 class="h5 cgc-clamp-3 mb-8">{titulo}</h3>
    {autores && <p class="text-size--sm mb-4">{autores}</p>}
    {publicacion && <p class="text-size--sm text-color--gray mb-0"><em>{publicacion}</em></p>}
    <div class="mt-auto pt-16">
      <a href={href} target="_blank" rel="noopener" class="uc-btn btn-secondary cgc-btn-auto">Descargar PDF <i class="uc-icon">download</i><span class="uc-sr-only"> (abre en pestaña nueva)</span></a>
    </div>
  </div>
</article>
