---
// Card/Documento — PDF descargable. Variante con portada (Estudios) o con cita en campos (Artículos y WP).
// «Descargar PDF» lleva el atributo download (Sara, 05-11: abría el PDF en vez de bajarlo). El navegador solo lo respeta si
// el PDF está en el mismo dominio: en WordPress, subido a la biblioteca de medios del sitio. En el prototipo los PDF siguen
// en el sitio actual del Centro, así que todavía se abren en una pestaña nueva, con el ícono «launch» del Kit en vez del de
// descarga (DED, Rommy 24-11). Los que ya están en el prototipo (/docs/) se descargan.
// Artículos y WP: el abstract va plegado (<details>, P1-14 del 26-10) para que las cards queden parejas.
// modal: el PDF se entrega después de dejar los datos (estudio «Mapa académico», 19-11); el botón abre ese modal.
interface Props { titulo: string; tipo?: string; anio?: string; autores?: string; publicacion?: string; abstract?: string; portada?: boolean | string; href?: string; modal?: string }
const { titulo, tipo, anio, autores, publicacion, abstract, portada = false, href = '#', modal } = Astro.props;
---
<article class="uc-card card-height--same cgc-card cgc-card-doc" data-anio={anio} data-texto={`${titulo} ${autores ?? ''}`.toLowerCase()}>
  {portada && <img src={typeof portada === 'string' ? portada : '/img/ph-portada.svg'} class="uc-card-img cgc-img-portada" alt={`Portada de ${titulo}`} loading="lazy" width="640" height="340" />}
  <div class="uc-card_body">
    {(tipo || anio) && (
      <div class="d-flex align-items-center mb-12">
        {tipo && <span class="uc-tag">{tipo}</span>}
        {anio && <span class="text-size--sm text-color--gray ml-8">{anio}</span>}
      </div>
    )}
    <h3 class="h5 mb-8">{titulo}</h3>
    {autores && <p class="text-size--sm mb-4">{autores}</p>}
    {publicacion && <p class="text-size--sm text-color--gray mb-0"><em>{publicacion}</em></p>}
    {abstract && (
      <details class="cgc-abstract mt-12">
        <summary class="uc-btn btn-inline">Ver abstract<span class="uc-sr-only"> de «{titulo}»</span></summary>
        <p class="text-size--sm mt-8 mb-0">{abstract}</p>
      </details>
    )}
    <div class="mt-auto pt-16">
      {modal
        ? <button type="button" class="uc-btn btn-secondary cgc-btn-auto" data-mtarget={modal}>Descargar PDF<span class="uc-sr-only"> de «{titulo}»</span> <i class="uc-icon" aria-hidden="true">download</i></button>
        : href === '#'
        ? <a href="#" class="uc-btn btn-secondary cgc-btn-auto" data-pendiente="El PDF lo sube el Centro al panel de WordPress; en el prototipo aún no está.">Descargar PDF<span class="uc-sr-only"> de «{titulo}»</span> <i class="uc-icon" aria-hidden="true">download</i></a>
        : /^https?:/.test(href)
        ? <a href={href} target="_blank" rel="noopener" class="uc-btn btn-secondary cgc-btn-auto">Descargar PDF<span class="uc-sr-only"> de «{titulo}»</span> <i class="uc-icon" aria-hidden="true">launch</i><span class="uc-sr-only"> (archivo PDF, abre en una pestaña nueva)</span></a>
        : <a href={href} download class="uc-btn btn-secondary cgc-btn-auto">Descargar PDF<span class="uc-sr-only"> de «{titulo}»</span> <i class="uc-icon" aria-hidden="true">download</i><span class="uc-sr-only"> (archivo PDF)</span></a>}
    </div>
  </div>
</article>
