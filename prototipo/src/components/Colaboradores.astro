---
// Cinta de colaboradores (P1-17): desplazamiento continuo; se detiene con el puntero encima y respeta
// prefers-reduced-motion. Mateo, 29-10 (home v5): sin botón de pausa y solo los logos, sin recuadro de fondo.
import { colaboradores } from '../data/contenidos.js';
// 4 copias: con pocos logos, la mitad de la cinta (lo que se desplaza) debe ser más ancha que la pantalla.
const lista = [...colaboradores, ...colaboradores, ...colaboradores, ...colaboradores];
---
<section class="cgc-d-claro cgc-colaboradores" aria-labelledby="colaboradores-titulo">
  <div class="container">
    <div class="cgc-colaboradores_cabecera"><h2 id="colaboradores-titulo" class="cgc-d-ante cgc-d-texto-sec mb-0">Colaboradores</h2></div>
  </div>
  <div class="cgc-marquee" data-marquee>
    <ul class="cgc-marquee_track">
      {lista.map((c, i) => (
        <li class="cgc-marquee_item" aria-hidden={i >= colaboradores.length ? 'true' : undefined}>
          {c.logo ? <img src={c.logo} alt={`Logo ${c.nombre}`} loading="lazy" /> : <img src="/img/ph-logo.svg" alt={c.nombre} />}
        </li>
      ))}
    </ul>
  </div>
</section>
