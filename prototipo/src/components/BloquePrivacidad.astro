---
// Normativa UC de formularios: finalidad, acceso y plazo; checkbox obligatorio de cláusula de privacidad
// + checkbox opcional de uso posterior (nunca premarcado). Componentes .uc-form-check del Kit.
import { sitio } from '../data/sitio.js';
interface Props { finalidad: string; id: string }
const { finalidad, id } = Astro.props;
---
<div class="cgc-privacidad">
  <p class="text-size--sm mb-12">{finalidad} Acceden a ellos la coordinación del Centro UC Gobierno Corporativo y se conservan por [plazo por definir].</p>
  <div class="uc-form-check">
    <input id={`${id}-privacidad`} type="checkbox" required />
    <label for={`${id}-privacidad`}>He leído y acepto la cláusula de privacidad y la <a href={sitio.politicaPrivacidad} target="_blank" class="external">Política de Privacidad</a> de la UC. *</label>
    <input id={`${id}-uso`} type="checkbox" />
    <label for={`${id}-uso`}>Autorizo al Centro UC Gobierno Corporativo a enviarme información sobre futuros programas y actividades (opcional).</label>
  </div>
</div>
