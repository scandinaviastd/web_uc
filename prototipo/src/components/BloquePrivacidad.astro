---
// Cláusula de privacidad con los textos de los ejemplos del Kit Digital UC (kitdigital.uc.cl/componentes/formulario),
// validados por la mesa de protección de datos UC (pedido de la DED, 27-10). Más información y brochure son del
// tipo «contacto»: la cláusula obligatoria lleva su texto. El checkbox opcional de uso posterior, nunca premarcado,
// usa el recuadro «Opcional» del ejemplo de inscripción (lineamiento general: solo si se hará uso posterior).
// Inscripción a un evento (tipo «inscripción» del Kit): su propio texto, con el nombre de la actividad.
// En WordPress faltan el reCAPTCHA que traen los ejemplos y el registro de los consentimientos del opcional.
import { sitio } from '../data/sitio.js';
interface Props {
  id: string;
  tipo?: 'contacto' | 'inscripcion';
  finalidad?: string; // contacto: completa «tratar los datos personales para …»
  acepto?: string;    // contacto: completa «Acepto que la UC trate mis datos personales para …»
  actividad?: string; // inscripción: nombre de la actividad
  opcional?: boolean;
}
const { id, tipo = 'contacto', finalidad, acepto, actividad, opcional = true } = Astro.props;
const inscripcion = tipo === 'inscripcion';
---
<div class="cgc-privacidad">
  {inscripcion
    ? <p class="text-color--gray mb-16">Autorizo expresamente a la UC para tratar los datos personales necesarios para la inscripción a la actividad «{actividad}», los cuales serán informados a la unidad organizadora. Los datos personales serán usados solamente para la inscripción a esta actividad y se <strong>mantendrán mientras sean requeridos por Ley</strong>.</p>
    : <p class="text-color--gray mb-16">Autorizo expresamente a la UC para tratar los datos personales para {finalidad}. Los datos personales serán usados solamente para esta finalidad y se <strong>mantendrán mientras sean requeridos por Ley</strong>.</p>}
  <div class="uc-form-check">
    <input id={`${id}-privacidad`} type="checkbox" value="true" required aria-required="true" />
    <label for={`${id}-privacidad`} class="mb-0">* Acepto que la UC trate mis datos personales para {inscripcion ? 'esta actividad' : acepto}, y he leído y acepto la <a href={sitio.politicaPrivacidad} target="_blank" rel="noopener" class="external">Política de Privacidad UC<span class="uc-sr-only"> (abre en una pestaña nueva)</span></a>.</label>
  </div>
</div>
{opcional && (
  <div class="cgc-privacidad cgc-privacidad--opcional">
    <p class="mb-8"><strong>Opcional</strong></p>
    <p class="text-color--gray mb-16">Si desea recibir más información de actividades o seminarios de la UC, marque la siguiente casilla:</p>
    <div class="uc-form-check">
      <input id={`${id}-uso`} type="checkbox" value="true" />
      <label for={`${id}-uso`} class="mb-0">Acepto recibir más información de actividades o seminarios de la UC.</label>
    </div>
  </div>
)}
