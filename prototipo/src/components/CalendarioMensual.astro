---
// Calendario principal de Extensión (decisión A3 del 29-09): siempre visible, con todos los eventos
// (realizados y próximos) y navegación libre entre meses. Cada evento enlaza a su card más abajo.
// Lo pinta cgc.js con los datos de data-eventos; responde al filtro de tipo (chips).
import { eventosProximos, eventosRealizados } from '../data/contenidos.js';
const hoy = new Date().toISOString().slice(0, 10);
const todos = [...eventosRealizados, ...eventosProximos].map(({ id, fecha, tipo, titulo, hora }) => ({ id, fecha, tipo, titulo, hora: hora ?? '', pasado: fecha < hoy }));
// Parte en el mes actual si tiene eventos; si no, en el mes del próximo evento.
const mesActual = hoy.slice(0, 7);
const inicio = todos.some((e) => e.fecha.startsWith(mesActual)) ? mesActual : (eventosProximos[0]?.fecha.slice(0, 7) ?? mesActual);
---
<div class="cgc-calendario" data-calendario data-eventos={JSON.stringify(todos)} data-inicio={inicio}>
  <div class="d-flex align-items-center flex-wrap mb-16 cgc-calendario_nav">
    <button type="button" class="cgc-cal-btn" data-cal-prev aria-label="Mes anterior"><i class="uc-icon">keyboard_arrow_left</i></button>
    <h3 class="h4 mb-0 mx-16" data-cal-titulo aria-live="polite">Calendario</h3>
    <button type="button" class="cgc-cal-btn" data-cal-next aria-label="Mes siguiente"><i class="uc-icon">keyboard_arrow_right</i></button>
    <span class="ml-auto text-size--sm text-color--gray d-none d-md-inline">
      <span class="cgc-cal-swatch"></span> Próximo <span class="cgc-cal-swatch cgc-cal-swatch--pasado ml-16"></span> Realizado
    </span>
  </div>
  <div class="cgc-cal-grid" role="grid" aria-label="Calendario de eventos">
    <div class="cgc-cal-row cgc-cal-head" role="row">
      {['LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB', 'DOM'].map((d) => <div class="cgc-cal-dow" role="columnheader">{d}</div>)}
    </div>
    <div data-cal-semanas></div>
  </div>
</div>
