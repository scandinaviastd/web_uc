---
// Título de sección con decoración del Kit (.uc-heading-decoration), como en block-items-archive.php.
interface Props { titulo: string; link?: { label: string; href: string }; tag?: string; claro?: boolean; id?: string }
const { titulo, link, tag = 'h2', claro = false, id } = Astro.props;
const Tag = tag as any;
---
<div class="d-flex align-items-center flex-wrap mb-32 cgc-section-heading">
  <div class="d-flex align-items-center">
    <Tag id={id} class:list={['h2', 'mb-0', { 'color-white': claro }]}>{titulo}</Tag>
    <div class="uc-heading-decoration"></div>
  </div>
  {link && <a href={link.href} class:list={['uc-btn', 'btn-inline', 'ml-auto', { 'color-white': claro }]}>{link.label} <i class="uc-icon">arrow_forward</i></a>}
</div>
