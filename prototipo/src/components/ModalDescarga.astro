---
// Modal del Kit (.uc-modal, data-modal / data-mtarget) con formulario antes de descargar un documento (decisión A4).
// 26-10: primero se envían los datos y recién después aparece la descarga. El documento viaja como campo oculto,
// para que el contacto llegue al correo de Sara con el detalle (V-03, P1-19).
// DED, 27-10: tipo «contacto» del Kit (aviso de obligatorios al inicio y cláusula con el texto del Kit).
// Lo usan el brochure de cada programa (ModalBrochure) y el estudio «Mapa académico» (home y Estudios, Clara, 19-11).
import BloquePrivacidad from './BloquePrivacidad.astro';
interface Props {
  modal: string;            // valor de data-modal / data-mtarget
  id: string;               // id del modal y prefijo de los campos
  prefijo: string;
  titulo: string;           // «Descarga el brochure»
  subtitulo: string;        // nombre del programa o del estudio
  documento: string;        // «el brochure», «el estudio»
  campo: [string, string];  // campo oculto: nombre y valor
  archivo?: string;         // PDF; sin PDF, la descarga avisa que falta
  boton: string;            // texto del botón de descarga
  finalidad: string;
  acepto: string;
  pendiente?: string;
}
const { modal, id, prefijo, titulo, subtitulo, documento, campo, archivo, boton, finalidad, acepto, pendiente } = Astro.props;
const p = prefijo;
---
<div data-modal={modal} class="uc-modal cgc-modal" id={id}>
  <div class="uc-modal_content cgc-modal_content">
    <button type="button" class="uc-message_close-button" data-mclosed aria-label="Cerrar"><i class="uc-icon">close</i></button>
    <h2 class="h3 mb-4">{titulo}</h2>
    <p class="text-color--gray">{subtitulo}</p>
    <form class="cgc-form" data-form={id} novalidate>
      <input type="hidden" name={campo[0]} value={campo[1]} />
      <p>Déjanos tus datos y luego descarga {documento}.</p>
      <p class="text-size--sm text-color--gray">(*) Campos obligatorios necesarios para enviarte {documento} y poder contactarte. Los demás son opcionales.</p>
      <div class="uc-form-group"><label for={`${p}-nombre`}>Nombre y apellido *</label><input id={`${p}-nombre`} type="text" class="uc-input-style" placeholder="Ej: María González" required /></div>
      <div class="uc-form-group"><label for={`${p}-correo`}>Correo electrónico *</label><input id={`${p}-correo`} type="email" class="uc-input-style" placeholder="nombre@empresa.cl" required /></div>
      <div class="uc-form-group"><label for={`${p}-telefono`}>Teléfono (opcional)</label><input id={`${p}-telefono`} type="tel" class="uc-input-style" placeholder="+56 9 1234 5678" /></div>
      <div class="uc-form-group"><label for={`${p}-empresa`}>Empresa u organización (opcional)</label><input id={`${p}-empresa`} type="text" class="uc-input-style" placeholder="Nombre de tu empresa" /></div>
      <BloquePrivacidad id={p} finalidad={finalidad} acepto={acepto} />
      <button type="submit" class="uc-btn btn-secondary cgc-btn-auto mt-16" data-form-enviar>Enviar mis datos</button>
      <div class="mt-16 cgc-hidden" data-form-ok>
        <div class="uc-alert success mb-16"><div class="uc-alert_content"><i class="uc-icon icon-size--sm">check_circle</i><span class="p p-size--sm bold ml-8">¡Gracias! Ya puedes descargar {documento}.</span></div></div>
        <a href={archivo ?? '#'} class="uc-btn btn-primary cgc-btn-auto" download={archivo ? '' : undefined} data-pendiente={archivo ? undefined : pendiente}><i class="uc-icon">download</i> {boton}</a>
      </div>
    </form>
  </div>
</div>
