---
// Brochure de cada programa: formulario antes de la descarga (ModalDescarga, decisión A4 del 26-10).
// brochure: PDF del programa (Formando nuevos directores 2027, Sara, 18-11). Sin PDF, la descarga avisa que falta.
import ModalDescarga from './ModalDescarga.astro';
interface Props { programa: string; slug: string; brochure?: string }
const { programa, slug, brochure } = Astro.props;
---
<ModalDescarga
  modal="modalBrochure"
  id="brochure"
  prefijo="b"
  titulo="Descarga el brochure"
  subtitulo={programa}
  documento="el brochure"
  campo={['programa', slug]}
  archivo={brochure}
  boton="Descargar brochure"
  finalidad="enviarme el brochure y para que me contacte el Centro UC Gobierno Corporativo sobre este programa"
  acepto="recibir el brochure y que me contacten"
  pendiente="El brochure en PDF lo sube el Centro al panel de WordPress (P1-19); en el prototipo aún no está."
/>
