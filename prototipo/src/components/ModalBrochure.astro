---
// Modal del Kit (.uc-modal, data-modal / data-mtarget) con formulario antes de descargar el brochure (decisión A4).
// 26-10: primero se envían los datos y recién después aparece la descarga. El programa viaja como campo oculto,
// para que el contacto llegue al correo de Sara con el detalle del curso (V-03, P1-19).
// DED, 27-10: tipo «contacto» del Kit (aviso de obligatorios al inicio y cláusula con el texto del Kit).
import BloquePrivacidad from './BloquePrivacidad.astro';
interface Props { programa: string; slug: string }
const { programa, slug } = Astro.props;
---
<div data-modal="modalBrochure" class="uc-modal cgc-modal" id="brochure">
  <div class="uc-modal_content cgc-modal_content">
    <button type="button" class="uc-message_close-button" data-mclosed aria-label="Cerrar"><i class="uc-icon">close</i></button>
    <h2 class="h3 mb-4">Descarga el brochure</h2>
    <p class="text-color--gray">{programa}</p>
    <form class="cgc-form" data-form="brochure" novalidate>
      <input type="hidden" name="programa" value={slug} />
      <p>Déjanos tus datos y luego descarga el brochure.</p>
      <p class="text-size--sm text-color--gray">(*) Campos obligatorios necesarios para enviarte el brochure y poder contactarte. Los demás son opcionales.</p>
      <div class="uc-form-group"><label for="b-nombre">Nombre y apellido *</label><input id="b-nombre" type="text" class="uc-input-style" placeholder="Ej: María González" required /></div>
      <div class="uc-form-group"><label for="b-correo">Correo electrónico *</label><input id="b-correo" type="email" class="uc-input-style" placeholder="nombre@empresa.cl" required /></div>
      <div class="uc-form-group"><label for="b-telefono">Teléfono (opcional)</label><input id="b-telefono" type="tel" class="uc-input-style" placeholder="+56 9 1234 5678" /></div>
      <div class="uc-form-group"><label for="b-empresa">Empresa u organización (opcional)</label><input id="b-empresa" type="text" class="uc-input-style" placeholder="Nombre de tu empresa" /></div>
      <BloquePrivacidad id="b" finalidad="enviarme el brochure y para que me contacte el Centro UC Gobierno Corporativo sobre este programa" acepto="recibir el brochure y que me contacten" />
      <button type="submit" class="uc-btn btn-secondary cgc-btn-auto mt-16" data-form-enviar>Enviar mis datos</button>
      <div class="mt-16 cgc-hidden" data-form-ok>
        <div class="uc-alert success mb-16"><div class="uc-alert_content"><i class="uc-icon icon-size--sm">check_circle</i><span class="p p-size--sm bold ml-8">¡Gracias! Ya puedes descargar el brochure.</span></div></div>
        <a href="#" class="uc-btn btn-primary cgc-btn-auto" data-pendiente="El brochure en PDF lo sube el Centro al panel de WordPress (P1-19); en el prototipo aún no está."><i class="uc-icon">download</i> Descargar brochure</a>
      </div>
    </form>
  </div>
</div>
