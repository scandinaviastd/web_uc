---
// Ficha de programa (nuevo modelo, minuta 07-09 §3): frase general + franja de datos clave con
// Postula (único amarillo) · Más información (formulario) · Descargar brochure (modal con formulario).
// Sin acordeones: todo el contenido visible. En WordPress: single-programa.php.
import Breadcrumb from './Breadcrumb.astro';
import ModalBrochure from './ModalBrochure.astro';
import { jefePrograma, coordinacion } from '../data/programas.js';
import { sitio } from '../data/sitio.js';
import { fotoDe } from '../data/contenidos.js';
interface Props { p: any }
const { p } = Astro.props;
const datos = [
  ['event', 'Fechas', p.fechas], ['schedule', 'Horario', p.horario], ['location_on', 'Modalidad', p.modalidad], ['payments', 'Valor', p.valor],
];
---
<Breadcrumb items={[{ label: 'Formación', href: '/formacion/' }, { label: p.titulo }]} />
<section class="cgc-ficha-hero">
  <div class="container">
    <div class="mb-16">
      <span class="uc-tag cgc-tag-claro">{p.tipo}</span>
      <span class="uc-tag cgc-tag-estado ml-8">{p.estado}</span>
    </div>
    <h1 class="color-white mb-16">{p.titulo}</h1>
    <p class="p-size--lg color-white cgc-ficha-frase mb-0">{p.frase}</p>
  </div>
</section>

<div class="container cgc-datos-clave-wrap">
  <div class="uc-card cgc-datos-clave">
    <div class="uc-card_body d-lg-flex align-items-center">
      <dl class="cgc-datos row no-gutters flex-grow-1 mb-0">
        {datos.map(([ic, k, v]) => (
          <div class="col-6 col-lg-3 cgc-dato">
            <i class="uc-icon cgc-dato_icon">{ic}</i>
            <div><dt class="text-size--sm text-color--gray">{k}</dt><dd class="text-weight--bold mb-0">{v}</dd></div>
          </div>
        ))}
      </dl>
      <div class="cgc-acciones mt-24 mt-lg-0">
        <a href="#" class="uc-btn btn-cta" data-pendiente="El destino de «Postula» está pendiente de definir con el Centro (P1-03).">Postula <i class="uc-icon">arrow_forward</i></a>
        <a href={`/formacion/mas-informacion/?programa=${p.slug}`} class="uc-btn btn-secondary cgc-btn-auto">Más información</a>
        <button type="button" class="uc-btn btn-primary cgc-btn-auto" data-mtarget="modalBrochure"><i class="uc-icon">download</i> Descargar brochure</button>
      </div>
    </div>
  </div>
</div>

<div class="container mt-60 mb-80">
  <div class="row">
    <div class="col-lg-8">
      <section class="mb-60">
        <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Sobre el programa</h2><div class="uc-heading-decoration"></div></div>
        <p>{p.descripcion}</p>
        <div class="row mt-24">
          <div class="col-md-6 mb-24"><div class="cgc-mini"><h3 class="h6">Dirigido a</h3><p class="mb-0">{p.dirigido}</p></div></div>
          <div class="col-md-6 mb-24"><div class="cgc-mini"><h3 class="h6">{p.incluye ? 'Incluye' : 'Requisitos de ingreso'}</h3><p class="mb-0">{p.incluye ?? p.requisitos}</p></div></div>
        </div>
      </section>

      {!p.sinJefe && (
        <section class="mb-60">
          <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Jefe de programa</h2><div class="uc-heading-decoration"></div></div>
          <div class="uc-card cgc-persona-h">
            <div class="uc-card_body flex-md-row">
              <img src={fotoDe(jefePrograma.nombre) ?? '/img/ph-persona.svg'} class="cgc-persona-h_foto mr-md-24 mb-16 mb-md-0" alt={`Foto de ${jefePrograma.nombre}`} width="120" height="120" />
              <div>
                <h3 class="h5 mb-4">{jefePrograma.nombre}</h3>
                <p class="text-color--blue text-size--sm text-weight--medium mb-8">{jefePrograma.cargo}</p>
                <p class="mb-0">{jefePrograma.resena}</p>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="mb-60">
        <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Detalle del programa</h2><div class="uc-heading-decoration"></div></div>
        {p.detalle.map((d: any) => (
          <div class="cgc-detalle-item">
            <h3 class="h4">{d.titulo}</h3>
            {d.modulos
              ? <ul class="cgc-modulos">{d.modulos.map((m: string) => <li>{m}</li>)}</ul>
              : <p class="cgc-pendiente mb-0">{d.texto}</p>}
          </div>
        ))}
      </section>

      {p.descuentos && (
        <section>
          <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Valor y descuentos</h2><div class="uc-heading-decoration"></div></div>
          <table class="uc-table cgc-tabla-valores w-100">
            <tbody>
              <tr class="cgc-fila-valor"><th scope="row">Valor del programa</th><td class="text-right text-weight--bold">{p.valor}</td></tr>
              {p.descuentos.map(([k, v]: string[]) => <tr><th scope="row" class="text-weight--regular">{k}</th><td class="text-right text-weight--bold text-color--primary">{v}</td></tr>)}
            </tbody>
          </table>
          <p class="text-size--sm text-color--gray mt-12">Los descuentos no son acumulables y deben aplicarse previo al pago.</p>
        </section>
      )}
    </div>

    <aside class="col-lg-4 mt-40 mt-lg-0">
      <div class="uc-card cgc-sticky">
        <div class="uc-card_body">
          <h2 class="h5 mb-8">{(p.coordinacion ?? coordinacion).titulo}</h2>
          <p class="text-size--sm mb-16">{(p.coordinacion ?? coordinacion).persona}</p>
          <p class="mb-8"><i class="uc-icon text-color--primary">phone</i> {(p.coordinacion ?? coordinacion).telefono}</p>
          <p class="mb-24"><i class="uc-icon text-color--primary">mail</i> {(p.coordinacion ?? coordinacion).correo}</p>
          <a href={sitio.whatsappUrl} class="uc-btn btn-primary cgc-btn-auto" data-pendiente="Número de WhatsApp del Centro pendiente (P1-12)."><img src="/img/whatsapp-azul.svg" alt="" width="18" height="18" class="mr-8" /> Escríbenos por WhatsApp</a>
        </div>
      </div>
    </aside>
  </div>
</div>
<ModalBrochure programa={p.titulo} />
