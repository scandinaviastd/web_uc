---
// Página 404 (checklist UC §4). Basada en views/404.php del Kit.
import Base from '../layouts/Base.astro';
import CardAcceso from '../components/CardAcceso.astro';
---
<Base title="Página no encontrada">
  <div class="container mt-60 mb-80">
    <p class="uc-subtitle mb-16">Error 404</p>
    <h1>No encontramos esta página</h1>
    <p class="p-size--lg">Puede que la dirección haya cambiado con el nuevo sitio o que ya no exista.</p>
    <form class="d-flex cgc-search-form mt-32 mb-24" action="/busqueda/" role="search">
      <div class="uc-form-group no-margin flex-grow-1 mr-12">
        <input type="search" name="q" class="uc-input-style w-icon search" placeholder="Busca en el sitio" aria-label="Buscar en el sitio" />
        <span class="w-icon search"></span>
      </div>
      <button type="submit" class="uc-btn btn-secondary cgc-btn-auto">Buscar</button>
    </form>
    <div class="d-flex flex-wrap cgc-gap-16 mb-60">
      <a href="/" class="uc-btn btn-secondary cgc-btn-auto">Volver a la página de inicio <i class="uc-icon">chevron_right</i></a>
      <a href="/formacion/mas-informacion/" class="uc-btn btn-primary cgc-btn-auto">Contáctanos</a>
    </div>
    <div class="d-flex align-items-center mb-32"><h2 class="h3 mb-0">Secciones del sitio</h2><div class="uc-heading-decoration"></div></div>
    <div class="row">
      <div class="col-md-4 mb-32"><CardAcceso titulo="Formación" bajada="Programas abiertos y programas para empresas." href="/formacion/" /></div>
      <div class="col-md-4 mb-32"><CardAcceso titulo="Investigación" bajada="Red, artículos, working papers y estudios." href="/investigacion/" /></div>
      <div class="col-md-4 mb-32"><CardAcceso titulo="Extensión" bajada="Próximos eventos y prensa." href="/extension/" /></div>
    </div>
  </div>
</Base>
