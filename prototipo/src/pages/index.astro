---
import Base from '../layouts/Base.astro';
import CarruselPrincipal from '../components/CarruselPrincipal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CardPrograma from '../components/CardPrograma.astro';
import CardNoticia from '../components/CardNoticia.astro';
import CardOpinion from '../components/CardOpinion.astro';
import CardAcceso from '../components/CardAcceso.astro';
import InCompanyBlock from '../components/InCompanyBlock.astro';
import Colaboradores from '../components/Colaboradores.astro';
import { programas } from '../data/programas.js';
import { noticias, newsletters, prensa, accesosInvestigacion } from '../data/contenidos.js';
---
<Base title="Inicio" seccion="inicio" h1Oculto="Centro UC Gobierno Corporativo">
  <CarruselPrincipal />

  <section class="cgc-section">
    <div class="container">
      <SectionHeading titulo="Formación" link={{ label: 'Ver toda la oferta de Formación', href: '/formacion/' }} />
      <div class="row">
        {programas.map((p) => <div class="col-md-6 col-lg-3 mb-32"><CardPrograma p={{ ...p, inicioCorto: undefined, modalidad: undefined }} /></div>)}
      </div>
      <InCompanyBlock />
    </div>
  </section>

  <section class="cgc-section cgc-section--gray">
    <div class="container">
      <SectionHeading titulo="Noticias" link={{ label: 'Ver todas las noticias', href: '/extension/#noticias' }} />
      <div class="row">
        {noticias.map((n) => <div class="col-md-6 col-lg-3 mb-32"><CardNoticia {...n} /></div>)}
      </div>
    </div>
  </section>

  <section class="cgc-section">
    <div class="container">
      <SectionHeading titulo="Prensa" link={{ label: 'Ver toda la prensa', href: '/extension/prensa/' }} />
      <div class="row">
        {prensa.slice(0, 2).map((o) => <div class="col-lg-6 mb-32"><CardOpinion {...o} /></div>)}
      </div>
    </div>
  </section>

  <section class="cgc-section cgc-section--dark">
    <div class="container">
      <SectionHeading titulo="Investigación" claro />
      <p class="color-white cgc-bajada-dark mb-32">Generamos evidencia sobre gobierno corporativo en Chile y Latinoamérica.</p>
      <div class="row">
        {accesosInvestigacion.map((a) => <div class="col-md-4 mb-32"><CardAcceso {...a} /></div>)}
      </div>
    </div>
  </section>

  <section class="cgc-section">
    <div class="container">
      <SectionHeading titulo="Newsletters" link={{ label: 'Ver todos los newsletters', href: '/extension/#newsletters' }} />
      <div class="row">
        {newsletters.map((n) => <div class="col-md-4 mb-32"><CardNoticia {...n} cta="Leer newsletter" /></div>)}
      </div>
    </div>
  </section>

  <Colaboradores />
</Base>
