---
// Home v5 — propuesta «Dirección» (sub-design system con el lenguaje de Full Funnel, dentro del Kit UC).
// Espejo: Figma UC_CGC, «Sprint 5 · Propuesta v5 (Dirección)», frames 452:2 (1440) y 461:446 (375).
// Secciones: portada en modo Noche · cifras · 01 Formación · voz · 02 Investigación (Noche) · 03 Extensión
// · cinta de colaboradores (Mateo, 29-10: vuelve desde el Sprint 4, sin botón de pausa y sin recuadros).
import Base from '../layouts/Base.astro';
import Barra from '../components/v5/Barra.astro';
import Cifra from '../components/v5/Cifra.astro';
import Cita from '../components/v5/Cita.astro';
import TarjetaPrograma from '../components/v5/TarjetaPrograma.astro';
import Evento from '../components/v5/Evento.astro';
import Colaboradores from '../components/Colaboradores.astro';
import { programas, getPrograma } from '../data/programas.js';
import { whatsapp } from '../data/sitio.js';
import { cifraPortada, cifrasCentro, descripcionDiplomado, ordenCursos, citaPortada, cifrasEstudio, eventosHome, fotos } from '../data/v5-home.js';

const diplomado = programas.find((p) => p.tipo === 'Diplomado');
const cursos = ordenCursos.map(getPrograma).filter(Boolean);
const oferta = (p) => `${p.tipo} · Oferta 2027`;
const secciones = [
  { n: '01', label: 'Formación', href: '#formacion' },
  { n: '02', label: 'Investigación', href: '#investigacion' },
  { n: '03', label: 'Extensión', href: '#extension' },
  { n: '04', label: 'Servicios', href: '/servicios/' },
];
---
<Base title="Inicio" seccion="inicio">
  <link slot="head" rel="stylesheet" href="/css/v5-home.css" />

  <!-- Portada en modo Noche. Texto sobre superficie sólida; la foto nunca lleva texto encima. -->
  <section class="cgc-d-noche v5h-portada" aria-labelledby="portada-titulo">
    <div class="container">
      <div class="v5h-portada_grid">
        <div class="v5h-portada_texto">
          <p class="cgc-d-ante cgc-d-texto-marca mb-0">Centro UC Gobierno Corporativo · <span class="d-none d-md-inline">Formación </span>2027</p>
          <!-- Display XL 88/92 (44/48 en móvil): fuera de la escala del Kit, a validar con la DED -->
          <h1 id="portada-titulo" class="cgc-d-display-xl v5h-titulo">Alta Dirección:<br /><strong>formación útil<br />y al día</strong></h1>
          <p class="v5h-bajada v5h-bajada--portada mb-0">Fórmate confiando en la rigurosidad académica UC y en su red de líderes en gobierno corporativo.</p>
          <div class="v5h-acciones">
            <a href="/formacion/" class="uc-btn btn-cta cgc-btn-auto v5h-cta">Ver programas 2027</a>
            <a href={whatsapp.url()} class="cgc-d-enlace" target="_blank" rel="noopener">Conversemos por WhatsApp →<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
          </div>
        </div>
        <div class="v5h-portada_media">
          <img src={fotos.portada.src} alt={fotos.portada.alt} class="v5h-portada_foto" width="1600" height="1066" fetchpriority="high" />
          <span class="v5h-acento v5h-portada_acento" aria-hidden="true"></span>
          <!-- Bloque azul 2727 que pisa la foto y se sale de ella (recurso de Full Funnel): el texto va sobre el bloque -->
          <Cifra cifra={cifraPortada.cifra} etiqueta={cifraPortada.etiqueta} fondo="marca" class="v5h-portada_cifra d-none d-md-flex" />
          <Cifra cifra={cifraPortada.cifra} etiqueta={cifraPortada.etiquetaMovil} fondo="marca" class="v5h-portada_cifra d-md-none" />
        </div>
      </div>

      <!-- Índice de secciones: la barra del manual de la submarca, convertida en índice de las cuatro secciones -->
      <nav class="v5h-indice" aria-label="Secciones del Centro">
        <ol class="v5h-indice_lista d-none d-md-flex">
          {secciones.map((s, i) => (
            <li><a href={s.href} class:list={['cgc-d-indice', { 'is-actual': i === 0 }]}>{s.n}&nbsp;&nbsp;{s.label}</a></li>
          ))}
        </ol>
        <p class="cgc-d-indice v5h-indice_movil d-md-none mb-0">01 / 04&nbsp;&nbsp;·&nbsp;&nbsp;Formación</p>
        <Barra indice={1} />
      </nav>
    </div>
  </section>

  <!-- Cifras del Centro (brochure 2026) -->
  <section class="cgc-d-claro v5h-cifras" aria-label="El Centro en cifras">
    <div class="container">
      <div class="v5h-cifras_lista">
        {cifrasCentro.map((c) => c.etiquetaMovil
          ? <><Cifra cifra={c.cifra} etiqueta={c.etiqueta} class="d-none d-md-flex" /><Cifra cifra={c.cifra} etiqueta={c.etiquetaMovil} class="d-md-none" /></>
          : <Cifra cifra={c.cifra} etiqueta={c.etiqueta} />)}
      </div>
    </div>
  </section>

  <!-- 01 Formación: diplomado horizontal + cursos en fila de 3 (V-09, aprobada el 26-10) -->
  <section id="formacion" class="cgc-d-suave v5h-seccion v5h-formacion" aria-labelledby="formacion-titulo">
    <div class="container">
      <header class="v5h-encabezado">
        <p class="v5h-indice-sec mb-0"><span class="cgc-d-indice cgc-d-texto-marca">01</span><span class="cgc-d-ante cgc-d-texto-sec">Formación</span></p>
        <h2 id="formacion-titulo" class="cgc-d-display-l v5h-titulo">Programas para la<br /><strong>Alta Dirección</strong></h2>
        <p class="v5h-bajada mb-0">Un diplomado y tres cursos abiertos para 2027, además de programas In Company a la medida de cada directorio.</p>
      </header>

      {diplomado && (
        <>
          <div class="d-none d-md-block">
            <TarjetaPrograma horizontal titulo={diplomado.titulo} tipo={diplomado.tipo} meta={oferta(diplomado)} href={`/formacion/${diplomado.slug}/`} descripcion={descripcionDiplomado} whatsapp={whatsapp.url(diplomado.whatsappTema)} />
          </div>
          <!-- En móvil el diplomado usa la tarjeta vertical (la horizontal no cabe en 375) -->
          <div class="d-md-none">
            <TarjetaPrograma titulo={diplomado.titulo} tipo={diplomado.tipo} meta={oferta(diplomado)} href={`/formacion/${diplomado.slug}/`} />
          </div>
        </>
      )}

      <!-- Cursos: fila de 3 desde lg; carrusel con scroll-snap nativo debajo (la tarjeta siguiente se asoma) -->
      <div class="v5h-carrusel" data-scroll-x role="region" aria-label="Cursos 2027">
        {cursos.map((p) => (
          <div class="v5h-carrusel_item">
            <TarjetaPrograma titulo={p.titulo} tipo={p.tipo} meta={oferta(p)} href={`/formacion/${p.slug}/`} />
          </div>
        ))}
      </div>

      <div class="v5h-cierre">
        <p class="v5h-pista d-lg-none mb-0" aria-hidden="true">Desliza para ver los tres cursos →</p>
        <Barra />
        <a href="/formacion/" class="cgc-d-enlace">Ver toda la oferta de Formación →</a>
      </div>
    </div>
  </section>

  <!-- Voz: cita del brochure 2026 (lámina 5) sobre azul 2727 (superficie a validar con la DED) -->
  <section class="cgc-d-marca v5h-voz" aria-label="La voz del Centro">
    <div class="container">
      <div class="v5h-voz_grid">
        <Cita cita={citaPortada.cita} nombre={citaPortada.nombre} cargo={citaPortada.cargo} fondo="marca" class="v5h-voz_cita" />
        <figure class="v5h-voz_media mb-0">
          <img src={fotos.voz.src} alt={fotos.voz.alt} class="v5h-voz_foto" width="1600" height="1066" loading="lazy" />
          <span class="v5h-acento v5h-voz_acento" aria-hidden="true"></span>
        </figure>
      </div>
    </div>
  </section>

  <!-- 02 Investigación en modo Noche: estudio «Mapa académico» de los directores IPSA -->
  <section id="investigacion" class="cgc-d-noche v5h-seccion v5h-investigacion" aria-labelledby="investigacion-titulo">
    <div class="container">
      <header class="v5h-encabezado">
        <p class="v5h-indice-sec mb-0"><span class="cgc-d-indice cgc-d-texto-marca">02</span><span class="cgc-d-ante cgc-d-texto-sec">Investigación</span></p>
        <h2 id="investigacion-titulo" class="cgc-d-display-l v5h-titulo">Mapa académico:<br /><strong>dónde se forman los directores de Chile</strong></h2>
        <p class="v5h-bajada mb-0">El Centro estudió el perfil académico de los directores de las empresas IPSA: dónde se formaron, qué estudiaron y en qué países.</p>
      </header>
      <div class="v5h-estudio">
        {cifrasEstudio.map((c) => <Cifra cifra={c.cifra} etiqueta={c.etiqueta} fondo={c.fondo ?? 'claro'} />)}
      </div>
      <div class="v5h-cierre">
        <Barra indice={2} />
        <!-- Destino pendiente: formulario de descarga del estudio (por definir con el Centro) -->
        <a href="/investigacion/estudios/" class="cgc-d-enlace v5h-enlace-largo" data-pendiente="El formulario para recibir el estudio completo está por definir con el Centro.">Déjanos tus datos y recibe el estudio completo →</a>
      </div>
    </div>
  </section>

  <!-- 03 Extensión: fotos reales de eventos + próximos y realizados -->
  <section id="extension" class="cgc-d-claro v5h-seccion v5h-extension" aria-labelledby="extension-titulo">
    <div class="container">
      <header class="v5h-encabezado">
        <p class="v5h-indice-sec mb-0"><span class="cgc-d-indice cgc-d-texto-marca">03</span><span class="cgc-d-ante cgc-d-texto-sec">Extensión</span></p>
        <h2 id="extension-titulo" class="cgc-d-display-l v5h-titulo">Conversación estratégica<br /><strong>para la Alta Dirección</strong></h2>
        <p class="v5h-bajada mb-0">Jornadas, debates y webinars con líderes empresariales a lo largo del año.</p>
      </header>
      <div class="v5h-fotos" data-scroll-x>
        {fotos.eventos.map((f) => <img src={f.src} alt={f.alt} width="1600" height="1066" loading="lazy" />)}
      </div>
      <!-- Provisorio: títulos del Figma v5; el título exacto de cada evento lo confirma el Centro -->
      <div class="v5h-eventos">
        {eventosHome.map((e) => <Evento {...e} />)}
      </div>
      <a href="/extension/#eventos" class="cgc-d-enlace">Ver todos los eventos →</a>
    </div>
  </section>

  <Colaboradores />
</Base>
