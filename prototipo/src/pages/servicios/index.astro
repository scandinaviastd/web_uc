---
// Servicios v5 · propuesta «Dirección» (Figma UC_CGC: escritorio 465:1049, móvil 468:1573).
// Antes «Asesorías» (renombrada el 26-10). Va última en el menú. El contenido sigue pendiente del Centro (P1-01):
// los textos de src/data/v5-servicios.js son propuesta del estudio a validar (brochure 2026 de Full Funnel).
// A validar con la DED: Display L, Cifra y el azul 2727 como superficie (portada, tarjeta 01 y banda).
import Base from '../../layouts/Base.astro';
import Cifra from '../../components/v5/Cifra.astro';
import Barra from '../../components/v5/Barra.astro';
import { portada, ofrecemos, servicios, banda } from '../../data/v5-servicios.js';
---
<Base title="Servicios" seccion="servicios" descripcion={portada.bajada}>
  <link slot="head" rel="stylesheet" href="/css/v5-servicios.css" />

  <!-- Portada · modo Noche. Texto sobre superficie sólida, nunca sobre la foto; la cifra va en un bloque que pisa la foto. -->
  <section class="cgc-d-noche v5s-portada">
    <div class="container">
      <div class="row">
        <div class="col-lg-6 v5s-portada_texto">
          <p class="cgc-d-ante cgc-d-texto-marca mb-0">{portada.antetitulo}</p>
          <h1 class="cgc-d-display-l v5s-titular">{portada.titular.claro}<br /><strong>{portada.titular.enfasis[0]}<br />{portada.titular.enfasis[1]}</strong></h1>
          <p class="p-size--lg v5s-portada_bajada mb-0">{portada.bajada}</p>
          <div class="v5s-acciones">
            <a href={portada.cta.href} class="uc-btn btn-cta cgc-btn-auto v5s-cta">{portada.cta.label}</a>
            <a href={portada.whatsapp.href} class="cgc-d-enlace" target="_blank" rel="noopener">{portada.whatsapp.label} →<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="v5s-composicion">
            <img src={portada.foto.src} alt={portada.foto.alt} class="v5s-composicion_foto" width="1600" height="1066" />
            <span class="v5s-composicion_acento" aria-hidden="true"></span>
            <Cifra cifra={portada.cifra.cifra} etiqueta={portada.cifra.etiqueta} fondo="marca" class="v5s-composicion_cifra" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Lo que ofrecemos. Candidato a componente: «Tarjeta de servicio». -->
  <section class="v5s-ofrecemos" aria-labelledby="v5s-ofrecemos-titulo">
    <div class="container">
      <div class="v5s-encabezado">
        <p class="v5s-indice mb-0"><span class="cgc-d-indice cgc-d-texto-marca">{ofrecemos.indice}</span><span class="cgc-d-ante cgc-d-texto-sec">{ofrecemos.antetitulo}</span></p>
        <h2 id="v5s-ofrecemos-titulo" class="cgc-d-display-l v5s-titular">{ofrecemos.titular.claro}<br /><strong>{ofrecemos.titular.enfasis}</strong></h2>
      </div>
      <div class="row v5s-servicios">
        {servicios.map((s) => (
          <div class="col-lg-4">
            <article class="v5s-servicio">
              <div class="v5s-servicio_bloque" data-fondo={s.fondo}>
                <span class="cgc-d-indice v5s-servicio_n" aria-hidden="true">{s.n}</span>
                <h3 class="h3 v5s-servicio_titulo">{s.titulo}</h3>
              </div>
              <div class="v5s-servicio_cuerpo">
                <p class="mb-0">{s.texto}</p>
                <Barra />
                {s.accion.externo
                  ? <a href={s.accion.href} class="cgc-d-enlace" target="_blank" rel="noopener">{s.accion.label} →<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
                  : <a href={s.accion.href} class="cgc-d-enlace">{s.accion.label} →</a>}
              </div>
            </article>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Banda · Empresas Socias, sobre azul 2727: titular blanco grande (4,1:1); texto y enlace en azul noche (4,5:1). -->
  <section id="empresas-socias" class="cgc-d-marca v5s-banda" aria-labelledby="v5s-banda-titulo">
    <div class="container">
      <div class="row align-items-center v5s-banda_fila">
        <div class="col-lg-8">
          <h2 id="v5s-banda-titulo" class="cgc-d-display-l v5s-banda_titular">{banda.titular.claro} <strong>{banda.titular.enfasis}</strong></h2>
        </div>
        <div class="col-lg-4">
          <div class="v5s-banda_accion">
            <p class="p-size--lg mb-0">{banda.texto}</p>
            <a href={banda.accion.href} class="cgc-d-enlace" target="_blank" rel="noopener">{banda.accion.label} →<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
