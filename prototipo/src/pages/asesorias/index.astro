---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageTitle from '../../components/PageTitle.astro';
---
<Base title="Asesorías" seccion="asesorias">
  <Breadcrumb items={[{ label: 'Asesorías' }]} />
  <PageTitle titulo="Asesorías" bajada="[Bajada de la sección — la define el Centro]" />
  <div class="container mb-80">
    <div class="cgc-pendiente-box">
      <h2 class="h4">Contenido por definir (minuta 07-09 §7, "Sigue abierto")</h2>
      <p class="mb-0">El Centro define qué contiene Asesorías. Candidatos ya diseñados en el Sprint 1: investigación por encargo y documentos para directores (hoy en "Fuera de alcance"). También podría alojar In Company si el Centro lo decide.</p>
    </div>
  </div>
</Base>
