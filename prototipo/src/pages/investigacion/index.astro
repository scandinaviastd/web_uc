---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageTitle from '../../components/PageTitle.astro';
import CardAcceso from '../../components/CardAcceso.astro';
import CardDocumento from '../../components/CardDocumento.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { articulos, accesosInvestigacion } from '../../data/contenidos.js';
---
<Base title="Investigación" seccion="investigacion">
  <Breadcrumb items={[{ label: 'Investigación' }]} />
  <PageTitle titulo="Investigación" bajada="Generamos evidencia sobre gobierno corporativo en Chile y Latinoamérica." />
  <div class="container mb-40">
    <h2 class="uc-sr-only">Secciones de Investigación</h2>
    <div class="row">
      {accesosInvestigacion.map((a) => <div class="col-md-4 mb-32"><CardAcceso {...a} /></div>)}
    </div>
  </div>
  <section class="cgc-section cgc-section--gray">
    <div class="container">
      <SectionHeading titulo="Últimos artículos y working papers" link={{ label: 'Ver todos los artículos y working papers', href: '/investigacion/articulos-y-working-papers/' }} />
      <div class="row">
        {articulos.slice(0, 3).map((d) => <div class="col-md-4 mb-32"><CardDocumento {...d} /></div>)}
      </div>
    </div>
  </section>
</Base>
