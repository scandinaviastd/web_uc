---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageTitle from '../../components/PageTitle.astro';
import CalendarioMensual from '../../components/CalendarioMensual.astro';
import FiltroFecha from '../../components/FiltroFecha.astro';
import CardNoticia from '../../components/CardNoticia.astro';
import CardOpinion from '../../components/CardOpinion.astro';
import Pagination from '../../components/Pagination.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { eventosProximos, eventosRealizados, fechaEvento, prensa, tiposEvento } from '../../data/contenidos.js';
const vacio = (texto: string) => `<div class="uc-alert info"><div class="uc-alert_content"><i class="uc-icon icon-size--sm">info</i><span class="p p-size--sm bold ml-8">${texto}</span></div></div>`;
---
<Base title="Extensión" seccion="extension">
  <Breadcrumb items={[{ label: 'Extensión' }]} />
  <PageTitle titulo="Extensión" bajada="Seminarios, webinars, workshops, debates, charlas, desayunos, diálogos y jornadas abiertos a la comunidad." />
  <div class="container mb-60" data-filtro="eventos">
    <div class="cgc-chips mb-40" role="group" aria-label="Filtrar por tipo" data-chips="eventos" data-atributo="tipo">
      <span class="cgc-chips_label">Tipo:</span>
      <button type="button" class="cgc-chip is-active" aria-pressed="true" data-valor="*">Todos</button>
      {tiposEvento.map((t) => <button type="button" class="cgc-chip" aria-pressed="false" data-valor={t}>{`${t}s`}</button>)}
    </div>
    <section aria-labelledby="calendario-titulo" class="mb-60">
      <h2 id="calendario-titulo" class="uc-sr-only">Calendario de eventos</h2>
      <CalendarioMensual />
    </section>
    <section id="proximos" aria-labelledby="proximos-titulo" data-seccion-eventos="proximos">
      <div class="d-flex align-items-center flex-wrap mb-8">
        <h2 id="proximos-titulo" class="h3 mb-0 mr-16">Próximos eventos</h2>
        <FiltroFecha seccion="proximos" etiqueta="próximos eventos" fechas={eventosProximos.map((e) => e.fecha)} />
      </div>
      <p class="text-size--sm text-color--gray mb-24" data-ff-estado>{eventosProximos.length} eventos programados · en orden cronológico</p>
      <div class="row" data-lista>
        {eventosProximos.map((e) => <div id={e.id} class="col-md-6 col-lg-4 mb-32" data-item data-tipo={e.tipo} data-fecha={e.fecha}><CardNoticia fecha={fechaEvento(e.fecha).corta} tipo={e.tipo} titulo={e.titulo} imagen={e.imagen} cta="Ver evento" /></div>)}
      </div>
      <div data-vacio hidden set:html={vacio('No hay próximos eventos con estos filtros.')} />
      <p class="text-size--sm text-color--gray mt-8"><em>Eventos de ejemplo: las fechas reales llegan con el calendario interno del Centro.</em></p>
    </section>
    <section id="realizados" aria-labelledby="realizados-titulo" data-seccion-eventos="realizados">
      <div class="d-flex align-items-center flex-wrap mt-60 mb-8">
        <h2 id="realizados-titulo" class="h3 mb-0 mr-16">Realizados</h2>
        <FiltroFecha seccion="realizados" etiqueta="eventos realizados" fechas={eventosRealizados.map((e) => e.fecha)} />
      </div>
      <p class="text-size--sm text-color--gray mb-24" data-ff-estado>23 actividades realizadas · mostrando 6 · de la más reciente a la más antigua</p>
      <div class="row" data-lista>
        {eventosRealizados.map((e) => <div id={e.id} class="col-md-6 col-lg-4 mb-32" data-item data-tipo={e.tipo} data-fecha={e.fecha}><CardNoticia fecha={fechaEvento(e.fecha).corta} tipo={e.tipo} titulo={e.titulo} imagen={e.imagen} cta="Ver resumen" /></div>)}
      </div>
      <div data-vacio hidden set:html={vacio('No hay eventos realizados con estos filtros.')} />
      <Pagination paginas={[1, 2, 3, 4]} />
    </section>
  </div>
  <section class="cgc-section cgc-section--gray">
    <div class="container">
      <SectionHeading titulo="Prensa" link={{ label: 'Ver todo Prensa', href: '/extension/prensa/' }} />
      <p class="mb-32">Columnas y apariciones en medios de académicos y directores del Centro.</p>
      <div class="row">
        {prensa.slice(0, 2).map((o) => <div class="col-lg-6 mb-32"><CardOpinion {...o} /></div>)}
      </div>
    </div>
  </section>
</Base>
