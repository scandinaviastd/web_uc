---
// Página de cada evento (26-10: el calendario y las cards llevan al evento completo). En WordPress: single-evento.php.
// Propuesta v5: usa EventoDireccion (sub-design system «Dirección»). La versión Sprint 4 queda en la etiqueta `sprint-4`.
import Base from '../../../layouts/Base.astro';
import EventoDireccion from '../../../components/v5/EventoDireccion.astro';
import { eventos } from '../../../data/contenidos.js';
export function getStaticPaths() {
  return eventos.map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
---
<Base title={e.titulo} seccion="extension" descripcion={`${e.tipo} · ${e.fechaLarga}`}>
  <link slot="head" rel="stylesheet" href="/css/v5-ficha.css" />
  <link slot="head" rel="stylesheet" href="/css/v5-evento.css" />
  <EventoDireccion e={e} />
</Base>
