---
// Formulario "Más información" — propuesta Scandinavia según la normativa UC de formularios (decisión A6: se mantiene).
// 26-10 (V-03, P1-19): cada envío llega al correo de Sara con el programa elegido.
// DED, 27-10: tipo «contacto» del Kit (aviso de obligatorios al inicio y cláusula con el texto del Kit).
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageTitle from '../../components/PageTitle.astro';
import BloquePrivacidad from '../../components/BloquePrivacidad.astro';
import { programas, inCompany } from '../../data/programas.js';
import { sitio, sara } from '../../data/sitio.js';
const opciones = [...programas, inCompany];
---
<Base title="Solicita más información" seccion="formacion">
  <Breadcrumb items={[{ label: 'Formación', href: '/formacion/' }, { label: 'Más información' }]} />
  <PageTitle titulo="Solicita más información" bajada="Déjanos tus datos y la coordinación del programa te contactará." />
  <div class="container mb-80">
    <div class="row cgc-row-gap">
      <div class="col-lg-8">
        <form class="cgc-form" data-form="mas-informacion" novalidate>
          <p class="text-size--sm text-color--gray">(*) Campos obligatorios necesarios para poder responder a tu consulta. Los demás son opcionales.</p>
          <div class="uc-form-group">
            <label for="f-programa">Programa de interés *</label>
            <select id="f-programa" class="uc-input-style" required data-programa-select>
              {opciones.map((o) => <option value={o.slug}>{o.titulo}</option>)}
            </select>
            <p class="text-size--sm text-color--gray mt-8 mb-0" data-programa-ayuda hidden>Viene seleccionado desde la ficha del programa; puedes cambiarlo.</p>
          </div>
          <div class="row">
            <div class="col-md-6 uc-form-group"><label for="f-nombre">Nombre y apellido *</label><input id="f-nombre" type="text" class="uc-input-style" placeholder="Ej: María González" required /></div>
            <div class="col-md-6 uc-form-group"><label for="f-correo">Correo electrónico *</label><input id="f-correo" type="email" class="uc-input-style" placeholder="nombre@empresa.cl" required /></div>
            <div class="col-md-6 uc-form-group"><label for="f-telefono">Teléfono (opcional)</label><input id="f-telefono" type="tel" class="uc-input-style" placeholder="+56 9 1234 5678" /></div>
            <div class="col-md-6 uc-form-group"><label for="f-empresa">Empresa u organización (opcional)</label><input id="f-empresa" type="text" class="uc-input-style" placeholder="Nombre de tu empresa" /></div>
          </div>
          <div class="uc-form-group"><label for="f-consulta">Consulta (opcional)</label><textarea id="f-consulta" class="uc-input-style cgc-textarea" rows="5" placeholder="¿Qué te gustaría saber del programa?"></textarea></div>
          <BloquePrivacidad id="f" finalidad="que me contacte el Centro UC Gobierno Corporativo sobre el programa que elegí" acepto="que me contacten" />
          <button type="submit" class="uc-btn btn-secondary cgc-btn-auto mt-16">Enviar solicitud</button>
          <div class="uc-alert success mt-16 cgc-hidden" data-form-ok><div class="uc-alert_content"><i class="uc-icon icon-size--sm">check_circle</i><span class="p p-size--sm bold ml-8">Recibimos tu solicitud. La coordinación te contactará (demo).</span></div></div>
        </form>
      </div>
      <aside class="col-lg-4">
        <div class="uc-card cgc-sticky"><div class="uc-card_body">
          <span class="uc-subtitle d-block mb-8">Programa</span>
          <h2 class="h5 mb-16" data-programa-nombre>{programas[0].titulo}</h2>
          <hr class="uc-hr my-16" />
          <p class="text-weight--bold mb-8">¿Prefieres hablar con alguien?</p>
          <p class="text-size--sm mb-8">{sara.nombre}, {sara.cargo}<br /><a href={`mailto:${sara.correo}`}>{sara.correo}</a></p>
          <a href={sitio.whatsappUrl} class="uc-btn btn-inline cgc-btn-auto" target="_blank" rel="noopener"><img src="/img/whatsapp-verde.svg" alt="" width="18" height="18" class="mr-8" /> {sitio.whatsapp}<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
        </div></div>
      </aside>
    </div>
  </div>
</Base>
