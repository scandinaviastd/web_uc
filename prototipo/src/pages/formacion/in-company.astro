---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { inCompany as p } from '../../data/programas.js';
import { whatsapp } from '../../data/sitio.js';
---
<Base title={p.titulo} seccion="formacion" descripcion={p.frase}>
  <Breadcrumb items={[{ label: 'Formación', href: '/formacion/' }, { label: 'Programas para empresas' }]} />
  <link slot="head" rel="stylesheet" href="/css/v5-ficha.css" />
  <!-- Portada con franja de datos (Mateo, 09-11): reemplaza la card blanca con la frase suelta y los botones.
       Mismo patrón que la ficha v5 (cgc-v5f-datos): rótulo + dato con la barra corta, y un solo amarillo. -->
  <section class="cgc-ficha-hero cgc-d-noche cgc-ic-portada">
    <div class="container">
      <div class="mb-16"><span class="uc-tag cgc-tag-claro">{p.tipo}</span><span class="uc-tag cgc-tag-estado ml-8" data-estado={p.estado}>{p.estado}</span></div>
      <h1 class="color-white mb-16">{p.titulo}</h1>
      <p class="p-size--lg color-white cgc-ficha-frase mb-0">{p.frase}</p>
      <dl class="cgc-v5f-datos cgc-ic-datos">
        {p.datos.map(([k, v]) => <div class="cgc-v5f-dato"><dt class="cgc-d-ante">{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="cgc-v5f-acciones">
        <a href="/formacion/mas-informacion/?programa=in-company" class="uc-btn btn-cta cgc-btn-auto">Más información</a>
        <a href="#" class="cgc-d-enlace" data-pendiente="La presentación de In Company en PDF está pendiente del Centro.">Descargar presentación →</a>
      </div>
    </div>
  </section>
  <div class="container mt-60 mb-80">
    <div class="row cgc-row-gap">
      <div class="col-lg-8">
        <section class="mb-60">
          <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Sobre el programa</h2><div class="uc-heading-decoration"></div></div>
          <p>{p.descripcion}</p>
          <div class="row mt-24">
            <div class="col-md-6 mb-24"><div class="cgc-mini"><h3 class="h6">Dirigido a</h3><p class="mb-0">{p.dirigido}</p></div></div>
            <div class="col-md-6 mb-24"><div class="cgc-mini"><h3 class="h6">Incluye</h3><p class="mb-0">{p.incluye}</p></div></div>
          </div>
        </section>
        <section>
          <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Detalle del programa</h2><div class="uc-heading-decoration"></div></div>
          <div class="cgc-detalle-item">
            <h3 class="h4">Contenidos (se diseñan con cada organización)</h3>
            <ul class="cgc-modulos">{p.contenidos.map((m) => <li>{m}</li>)}</ul>
          </div>
        </section>
      </div>
      <aside class="col-lg-4">
        <div class="uc-card cgc-sticky"><div class="uc-card_body">
          <h2 class="h5 mb-8">{p.coordinacion.titulo}</h2>
          <p class="text-size--sm mb-16">{p.coordinacion.persona}</p>
          <p class="mb-24"><i class="uc-icon text-color--primary">mail</i> <a href={`mailto:${p.coordinacion.correo}`}>{p.coordinacion.correo}</a></p>
          <a href={whatsapp.url(p.whatsappTema)} class="uc-btn btn-primary cgc-btn-auto" target="_blank" rel="noopener"><img src="/img/whatsapp-verde.svg" alt="" width="18" height="18" class="mr-8" /> WhatsApp {whatsapp.numero}<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
        </div></div>
      </aside>
    </div>
  </div>
</Base>
