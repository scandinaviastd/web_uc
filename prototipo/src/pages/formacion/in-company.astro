---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { inCompany as p } from '../../data/programas.js';
import { whatsapp, telHref } from '../../data/sitio.js';
---
<Base title={p.titulo} seccion="formacion" descripcion={p.frase}>
  <Breadcrumb items={[{ label: 'Formación', href: '/formacion/' }, { label: 'Programas para empresas (In Company)' }]} />
  <section class="cgc-ficha-hero">
    <div class="container">
      <div class="mb-16"><span class="uc-tag cgc-tag-claro">{p.tipo}</span><span class="uc-tag cgc-tag-estado ml-8">{p.estado}</span></div>
      <h1 class="color-white mb-16">{p.titulo}</h1>
      <p class="p-size--lg color-white cgc-ficha-frase mb-0">{p.frase}</p>
    </div>
  </section>
  <div class="container cgc-datos-clave-wrap">
    <div class="uc-card cgc-datos-clave">
      <div class="uc-card_body d-lg-flex align-items-center justify-content-between">
        <p class="mb-0">{p.intro}</p>
        <div class="cgc-acciones">
          <a href="/formacion/mas-informacion/?programa=in-company" class="uc-btn btn-cta">Más información</a>
          <a href="#" class="uc-btn btn-primary cgc-btn-auto" data-pendiente="La presentación de In Company en PDF está pendiente del Centro."><i class="uc-icon">download</i> Descargar presentación</a>
        </div>
      </div>
    </div>
  </div>
  <div class="container mt-60 mb-80">
    <div class="row cgc-row-gap">
      <div class="col-lg-8">
        <section class="mb-60">
          <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Sobre el programa</h2><div class="uc-heading-decoration"></div></div>
          <p>{p.descripcion}</p>
          <div class="row mt-24">
            <div class="col-md-6 mb-24"><div class="cgc-mini"><h3 class="h6">Dirigido a</h3><p class="mb-0">{p.dirigido}</p></div></div>
            <div class="col-md-6 mb-24"><div class="cgc-mini"><h3 class="h6">Incluye</h3><p class="mb-0">{p.incluye}</p></div></div>
          </div>
        </section>
        <section>
          <div class="d-flex align-items-center mb-24"><h2 class="h3 mb-0">Detalle del programa</h2><div class="uc-heading-decoration"></div></div>
          <div class="cgc-detalle-item">
            <h3 class="h4">Contenidos (se diseñan con cada organización)</h3>
            <ul class="cgc-modulos">{p.contenidos.map((m) => <li>{m}</li>)}</ul>
          </div>
        </section>
      </div>
      <aside class="col-lg-4">
        <div class="uc-card cgc-sticky"><div class="uc-card_body">
          <h2 class="h5 mb-8">{p.coordinacion.titulo}</h2>
          <p class="text-size--sm mb-16">{p.coordinacion.persona}</p>
          <p class="mb-8"><i class="uc-icon text-color--primary" aria-hidden="true">phone</i> <a href={telHref(p.coordinacion.telefono)}>{p.coordinacion.telefono}</a></p>
          <p class="mb-24"><i class="uc-icon text-color--primary">mail</i> <a href={`mailto:${p.coordinacion.correo}`}>{p.coordinacion.correo}</a></p>
          <a href={whatsapp.url('In Company para Directorios')} class="uc-btn btn-primary cgc-btn-auto" target="_blank" rel="noopener"><img src="/img/whatsapp-verde.svg" alt="" width="18" height="18" class="mr-8" /> WhatsApp {whatsapp.numero}<span class="uc-sr-only"> (abre WhatsApp en una pestaña nueva)</span></a>
        </div></div>
      </aside>
    </div>
  </div>
</Base>
